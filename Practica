body {
  margin: 0;
  font-family: Arial, sans-serif;
  background-color: #0b0c10; /* negro cósmico */
  color: #c5c6c7; /* gris claro */
  line-height: 1.6;
}

.acerca {
  padding: 50px 20px;
  text-align: center;
}

.acerca h1 {
  color: #66fcf1; /* azul celeste */
  font-size: 2.5em;
  margin-bottom: 20px;
}

.acerca p {
  max-width: 700px;
  margin: 10px auto;
  font-size: 1.1em;
}

.mision-vision {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  margin-top: 40px;
  gap: 20px;
}

.caja {
  background: #1f2833; /* gris azulado */
  padding: 20px;
  border-radius: 12px;
  box-shadow: 0px 4px 10px rgba(0,0,0,0.5);
  width: 300px;
  transition: transform 0.3s ease;
}

.caja:hover {
  transform: translateY(-5px);
}

.caja h2 {
  color: #45a29e;
  margin-bottom: 15px;
}

/*Aqui empieza el css para galeria */

img {
    max-width: 200px;
    height: auto;
    padding: 10px;
}


.contendor-imagenes {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 15px;
    padding: 1em 0;
}

.contendor-imagenes img {
    width: 100%;
    margin-bottom: 1em;
    break-inside: avoid;
    border-radius: 8px;
    box-shadow: 0 2px 5px rgba(0,0,0,0.2);
    transition: transform 0.2s ease;

}

.contendor-imagenes img:hover {
    transform: scale(1.03);
}








/* Estilos generales del cuerpo articulos */
body {
  font-family: Arial, sans-serif;
  background-color: #f4f7fa;
  margin: 0;
  padding: 0;
  color: #333;
}

/* Encabezado */
header {
  background-color: #2c3e50;
  color: white;
  padding: 15px;
  text-align: center;
}

/* Sección de artículos */
.articulos {
  max-width: 900px;
  margin: 30px auto;
  padding: 10px;
}

.articulos h2 {
  text-align: center;
  margin-bottom: 20px;
  color: #2c3e50;
}

/* Cada artículo como tarjetita */
.articulo-card {
  background-color: #ffffff;
  border-radius: 8px;
  padding: 15px 20px;
  margin-bottom: 20px;
  box-shadow: 0 2px 5px rgba(0,0,0,0.08);
  transition: transform 0.2s ease;
}

.articulo-card:hover {
  transform: translateY(-3px);
}

.articulo-card h3 a {
  text-decoration: none;
  color: #0056a3;
  font-size: 1.2em;
}

.articulo-card h3 a:hover {
  color: #1abc9c;
}

.articulo-card p {
  margin-top: 8px;
  font-size: 0.95em;
  color: #555;
}

/* Footer */
footer {
  background-color: #2c3e50;
  color: white;
  text-align: center;
  padding: 10px;
  margin-top: 30px;
