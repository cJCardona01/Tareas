/* Aqui empieza el css para la pagina Acerca del Blog*/

body {
  margin: 0;
  font-family: Arial, sans-serif;
  background-color: #0b0c10; /* negro cósmico */
  color: #c5c6c7; /* gris claro */
  line-height: 1.6;
}

.acerca {
  padding: 50px 20px;
  text-align: center;
}

.acerca h1 {
  color: #66fcf1; /* azul celeste */
  font-size: 2.5em;
  margin-bottom: 20px;
}

.acerca p {
  max-width: 700px;
  margin: 10px auto;
  font-size: 1.1em;
}

.mision-vision {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  margin-top: 40px;
  gap: 20px;
}

.caja {
  background: #1f2833; /* gris azulado */
  padding: 20px;
  border-radius: 12px;
  box-shadow: 0px 4px 10px rgba(0,0,0,0.5);
  width: 300px;
  transition: transform 0.3s ease;
}

.caja:hover {
  transform: translateY(-5px);
}

.caja h2 {
  color: #45a29e;
  margin-bottom: 15px;
}

/*Aqui empieza el css para galeria */

.galeria-astro {
  text-align: center;
  padding: 40px 20px;
}

.galeria-astro h1 {
  color: #66fcf1;
  font-size: 2.5em;
  margin-bottom: 10px;
}

.galeria-astro p {
  font-size: 1.1em;
  margin-bottom: 30px;
}

.grid-astro {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 20px;
}

.astro-item {
  background: #1f2833;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0px 4px 10px rgba(0,0,0,0.6);
  transition: transform 0.3s ease;
}

.astro-item:hover {
  transform: scale(1.05);
}

.astro-item img {
  width: 100%;
  height: 200px;
  object-fit: cover;
}

.astro-item p {
  margin: 10px;
  color: #45a29e;
  font-weight: bold;
}



