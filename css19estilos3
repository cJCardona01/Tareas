* {
    box-sizing: border-box;
    font-family: Arial, Helvetica, sans-serif;
}

body {
    margin: 0;
    background-color: antiquewhite;
}

.grid-container {
    display: grid;
    grid-template-areas:
        "header header header"
        "nav nav nav"
        "main main sidebar"
        "footer footer footer";
    grid-template-columns: 2fr 1fr 1fr;
    grid-template-rows: auto auto 1fr auto;
    min-height: 100vh;

}

.header {
    grid-area: header;
    display: flex;
    align-items: center;
    gap: 50px;
    padding: 20px;
    background-color: #610303;
    color: white;
    text-align: center;
}

.header .logo {
    width: 100px;
    height: auto;
}

.nav {
    grid-area: nav;
    background: #dBa39d;
    display: flex;
    gap: 30px;
    padding: 15px;
    justify-content: center;
}

.nav a {
    color: #610303;
    text-decoration: none;
    font-weight: bold;
}

.nav a:hover {
    text-decoration: underline;
}

.main {
    grid-area: main;
    background: white;
    padding: 20px;
    color: #610303;
}

.sidebar {
    grid-area: sidebar;
    background: #dBa39d;
    padding: 20px;
    margin: 2px;
    color: #610303;
}

.sidebar a {
    color: #610303;
    text-decoration: underline;
    font-style: italic;
    padding: 10px;
    margin-bottom: 20px;
}

.sidebar li {
    list-style: none;
    margin-bottom: 15px;
    text-align: center;
}

footer {
    text-align: center;
    padding: 8px 10px;
    /* Disminuido */
    background-color: #660808;
    color: #fbfdff;
    font-size: 0.75rem;
    /* Más pequeño */
}

.f-container {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
}

.f-container div {
    flex: 1;
    margin: 10px;
}

.f-links ul {
    list-style: none;
    padding: 0;
}

.f-links ul li {
    margin: 8px 0;
}

.f-links a {
    color: #66fcf1;
    text-decoration: none;
}

.f-links a:hover {
    text-decoration: underline;
}

.cards {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    /*Aquí modifiqué de cuantas
tarjetas se mostrará cada línea (2 en 2)*/
    gap: 20px;
    margin-top: 20px;
}

.card {
    width: 250px;
    height: 300px;
    perspective: 1000px;
    /*Modifica la cercanía del elemento y la
persona que ve con respecto al
eje z, esto es, da la ilusión de cambiar el tamaño de la tarjeta
mientras gira
para que parezca un objeto real*/
    margin: 0 auto;
}

.card-inner {
    position: relative;
    width: 100;
    height: 100%;
    transition: transform 0.8s;
    /*Establece el tiempo que tarda en
girar la tarjeta*/
    transform-style: preserve-3d;
    /*Crea el espacio 3D en el cual hay
un frente y un
detrás para que se muestre la parte de atrás de las tarjetas */
}

.card:hover .card-inner {
    transform: rotateY(180deg);
    /*Establece el eje respecto al cual
gira y la cantidad
de grados que gira*/
}

.card-front,
.card-back {
    position: absolute;
    /*Hace que las caras se superpongan y se
muestren en la misma posicion
para que de el efecto de que una esta detrás de la otra*/
    width: 100%;
    height: 100%;
    border-radius: 10px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    backface-visibility: hidden;
    padding: 15px;
    box-shadow: 0 4px 8px rgba(204, 204, 204, 0.2);
}

.card-front {
    background: white;
    color: #610303;
    font-weight: bold;
    font-size: x-large;
}

.card-back {
    background: #610303;
    color: #fff;
    transform: rotateY(180deg);
    /*Indica que la cara de atrás se va a
posicionar a 180 grados
con respecto a la primer cara y con respecto a qué eje*/
}

p {
    font-size: medium;
    /*Cambie la medida de la letra para que se vea en
contraste con la medida más grande de las tarjetas
*/
}

.card-front img {
    width: 230px;
    height: auto;
    margin-top: 15px;
}

.planEstudios {
    color: black;
}



.tarjetas2 {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    /* 3 columnas por fila */
    gap: 20px;
    /* espacio entre tarjetas */
    justify-items: center;
    /* centra horizontalmente cada tarjeta */
    align-items: center;
    /* centra verticalmente el contenido */
    margin: 20px auto;
    width: 80%;
    /* ancho total del bloque */
}

.tarjeta2 {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 150px;
    height: 100px;
    background: white;
    border-radius: 10px;
    text-decoration: none;
    color: #333;
    font-weight: bold;
    box-shadow: 0 0 10px rgba(0, 0, 0, 0.15);
    transition: all 0.3s ease;
    border: 2px solid transparent;
}

.tarjeta2:hover {
    transform: translateY(-5px);
    box-shadow: 0 0 15px rgba(0, 0, 0, 0.3);
    border-color: #0078d4;
}

.tarjeta2:active {
    transform: scale(0.97);
}
