<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width,
initial-scale=1.0">
    <title>Galería CBTIS 94</title>
    <link rel="stylesheet" href="estilos.css">
</head>

<body>
    <div class="grid-container">
        <header class="header">
            <img src="/imagenes/logocb94.jpeg" alt="Logo CBTIS 94" class="logo">
            <div class="header-text">
                <h1>Centro de Bachillerato Tecnológico Industrial y de
                    Serivicios No.94</h1>
                <h2>Pátzcuaro Michoacán</h2>
            </div>
        </header>
        <nav class="nav">
            <a href="#">Inicio</a>
            <a href="#">Especialidades</a>
            <a href="galeriaCBTIS94.html">Galería</a>
            <a href="#">Contacto</a>
        </nav>
        <main>
                <h2>Galería del CBTIS 94</h2>
                <p>Aquí puedes ver algunas imágenes del plantel:</p>
                <div class="galeria">
                    <img src="/imagenes/img1.jpg" alt="Actividad escolar 1">
                    <img src="/imagenes/img2.jpg" alt="Actividad escolar 2">
                    <img src="/imagenes/img3.jpg" alt="Actividad escolar 3">
                    <img src="/imagenes/img4.jpg" alt="Actividad escolar 4">
                    <img src="/imagenes/img5.jpg" alt="Actividad escolar 5">
                    <img src="/imagenes/img6.jpg" alt="Actividad escolar 6">
                    <img src="/imagenes/img7.jpg" alt="Actividad escolar 7">
                    <img src="/imagenes/img8.jpg" alt="Actividad escolar 8">
                    <img src="/imagenes/img9.jpg" alt="Actividad escolar 9">
                    <img src="/imagenes/img10.jpg" alt="Actividad escolar 10">
                    <img src="/imagenes/img11.jpg" alt="Actividad escolar 11">
                    <img src="/imagenes/img12.jpg" alt="Actividad escolar 12">
                </div>
        </main>

        <aside class="sidebar">
        <h3>Sitios de interés</h3>
        <ul>
            <li><a href="#">Secretaría de Educación
                    Pública</a></li>
            <li><a href="#">Página Oficial de la DGETI</a></li>
            <li><a href="#">TECNM Morelia</a></li>
        </ul>
        <video width="400" height="300" controls autoplay muted loop>
            <source src="/imagenes/V1.mp4" type="video/mp4">
            Tu navegador no soporta el video
        </video>
    </aside>
    </div>

    <footer id="contacto">
            <div class="f-container">
                <div class="f-links">
                    <h3>Contacto</h3>
                    <ul>
                        <li>
                            <p>Direccion: Calle Roberto Pita Cornejo,
                                Pátzcuaro Michoacan</p>
                            <p>Telefono: (434) 342 1551</p>
                            <p>Email: contacto@cbtis94.edu.mx</p>
                            <p>&copy 2025 CBTIS 94 - Todos los derechos
                                reservados</p>
                        </li>
                    </ul>
                </div>
            </div>
        </footer>
</body>

</html>
