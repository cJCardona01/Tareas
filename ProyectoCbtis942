estilos2.css:
body {
        display: flex;
        justify-content: center;
        background-color: #ffffff; 
}
.Logo_CBTis94 {
    width: 80px;
    height: auto;
    float: left;
    margin-right: 15px;
}

.contenedor-principal {
        width: 80%; 
        text-align: center; 
}

aside {
    width: 20%; 
    margin-left: 20px; 
}
img {
        width: 30%;
        height: auto; 
        border: 2px solid #333;
    }

footer {
        margin-top: auto; 
        text-align: center;
        padding: 10px;
        background-color: #333; 
        color: white;
        width: 95%; 
}
header {
        border-bottom: 2px solid #555; 
        padding-bottom: 10px; 
        margin-bottom: 20px; 
}
nav ul {
   
    list-style: none; 
    padding: 0;
    margin: 0;
    display: flex;
    justify-content: center; 
}


nav li {
    list-style: none; 
    margin: 0 15px; 
}


nav a {

    text-decoration: none; 
    color:  #800000;
    font-weight: bold;
}


nav a:hover {
    color: #b22222;
}

footer {
    background-color: #660808;
    color: #fbfdff;
    padding: 15px 10px;
    font-family: Arial, sans-serif;
    font-size: 0.85rem; 
}

.f-container {
    display:flex;
    justify-content: space-between;
    flex-wrap: wrap;
}

.f-conatiner div{
    flex: 1;
    margin: 10px;
}

.f-links ul{
    list-style: none;
    padding: 0;
}

.f-links ul li {
    margin: 8px 0;
}
.f-links a{
    color: #66fcf1;
    text-decoration: none;
}

.f-links a:hover{
    text-decoration: underline;
}



