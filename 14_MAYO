import 'dart:ffi';

class Domicilio {
  int? id;
  String direccion;
  String ciudad;
  String estado; // Nuevo campo
  String codigoPostal;
  int idAlumno;  // Nuevo campo

 Domicilio({this.id, required this.direccion, required this.ciudad, required this.estado, required this.codigoPostal, required this.idAlumno });
  
  Map<String, dynamic> toMap() {
    return {'id': id, 'direccion': direccion, 'ciudad': ciudad,'estado':estado, 'codigoPostal': codigoPostal, 'idAlumno': idAlumno};
  }
}


