import 'package:flutter/material.dart';
import 'pagina1.dart';
import 'pagina2.dart';
import 'pagina3.dart';
import 'pagina4.dart';

class HomePage extends StatelessWidget {
  const HomePage({super.key});
  @override
  Widget build(BuildContext context) {
    final TextEditingController _nombreController = TextEditingController();
    return Scaffold(
      appBar: AppBar(title: const Text("Home")),
      body: Center(
        child: Column(
          mainAxisAlignment: MainAxisAlignment.center,
          children: [
            Padding(
              padding: const EdgeInsets.all(16.0),
              child: TextField(
                controller: _nombreController, // 2. Lo conectas
                decoration: const InputDecoration(
                  labelText: "Escribe tu nombre:",
                ),
              ),
            ),

            ElevatedButton(
              onPressed: () {
                Navigator.push(
                  context,
                  MaterialPageRoute(
                    builder: (context) =>
                        Pagina1(nombre: _nombreController.text),
                  ),
                );
              },
              child: const Text("Ir a la pagina 1"),
            ),
            const SizedBox(height: 20),

            ElevatedButton(
              onPressed: () {
                Navigator.push(
                  context,
                  MaterialPageRoute(builder: (context) => const Pagina2()),
                );
              },
              child: const Text("Ir a la pagina 2"),
            ),
            const SizedBox(height: 20),

            ElevatedButton(
              onPressed: () {
                Navigator.push(
                  context,
                  MaterialPageRoute(builder: (context) => const Pagina3()),
                );
              },
              child: const Text("Ir a la pagina 3"),
            ),
            const SizedBox(height: 20),

            ElevatedButton(
              onPressed: () {
                Navigator.push(
                  context,
                  MaterialPageRoute(builder: (context) => const Pagina4()),
                );
              },
              child: const Text("Ir a la pagina 4"),
            ),
            const SizedBox(height: 20),

            Image.network(
              'https://www.shutterstock.com/image-vector/welcome-spanish-language-600nw-2555287773.jpg',
              width: 300,
              height: 300,
            ),
          ],
        ),
      ),
    );
  }
}




