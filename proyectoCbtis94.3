estilos.css:
body {
    display: flex;
    justify-content: center;
    background-color: #ffffff;
    font-family: Arial, sans-serif;
}

.Logo_CBTis94,
.logo-cbtis {
    width: 80px;
    height: auto;
    float: left;
    margin-right: 15px;
}

.contenedor-principal {
    width: 80%;
    text-align: center;
}

aside {
    width: 20%;
    margin-left: 20px;
    background-color: #800000; /* Rojo institucional */
    color: white;
    padding: 15px;
    border-radius: 5px;
}

aside a {
    color: #ffd700; /* Amarillo dorado institucional */
    text-decoration: none;
}

aside a:hover {
    text-decoration: underline;
}

img {
    width: 30%;
    height: auto;
    border: 2px solid #333;
}

footer {
    text-align: center;
    padding: 8px 10px; /* Disminuido */
    background-color: #660808;
    color: #fbfdff;
    font-size: 0.75rem; /* Más pequeño */
}

header {
    border-bottom: 2px solid #555;
    padding-bottom: 10px;
    margin-bottom: 20px;
}

nav ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    justify-content: center;
    background-color: #800000; /* Rojo institucional */
}

nav li {
    margin: 0 15px;
}

nav a {
    text-decoration: none;
    color: #ffd700; /* Amarillo dorado institucional */
    font-weight: bold;
    padding: 10px;
    display: block;
}

nav a:hover {
    background-color: #b22222;
    color: white;
}

.f-container {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
}

.f-container div {
    flex: 1;
    margin: 10px;
}

.f-links ul {
    list-style: none;
    padding: 0;
}

.f-links ul li {
    margin: 8px 0;
}

.f-links a {
    color: #66fcf1;
    text-decoration: none;
}

.f-links a:hover {
    text-decoration: underline;
}

/* Tarjetas para oferta educativa */
.tarjetas-container {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 15px;
    margin-top: 20px;
}

.tarjeta {
    background-color: #f4f4f4;
    border: 2px solid #800000;
    border-radius: 8px;
    width: 180px;
    padding: 15px;
    transition: transform 0.3s, background-color 0.3s;
}

.tarjeta:hover {
    background-color: #ffe4b5;
    transform: scale(1.05);
}



