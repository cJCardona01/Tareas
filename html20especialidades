            <div class="header-text">
                <h1>Centro de Bachillerato Tecnológico Industrial y de
                    Serivicios No.94</h1>
                <h2>Pátzcuaro Michoacán</h2>
            </div>
        </header>
        <nav class="nav">
            <a href="#">Inicio</a>
            <a href="especialidades.html">Especialidades</a>
            <a href="#">Galería</a>
