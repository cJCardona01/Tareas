<?php
ini_set('display_errors', 1);
   ini_set('display_startup_errors', 1);
   error_reporting(E_ALL);


include("conexion.php");


if ($_SERVER["REQUEST_METHOD"] == "POST") {
   $Color = $_POST['Color'];
   $Nivel = $_POST['Nivel'];


   if (!empty($Color) && !empty($Nivel)) {
       $sql = "INSERT INTO Clasificacion_de_Reactivos (Color, Nivel) VALUES (?, ?)";
       $stmt = $conexion->prepare($sql);
       $stmt->bind_param("ss", $Color, $Nivel);


       if ($stmt->execute()) {
             header ("Location:clasificacion_reactivo.php");
       
       } else {
           echo "Error: " . $conexion->error;
       }
       $stmt->close();
   } else {
       echo "Por favor completa todos los campos.";
   }
}
