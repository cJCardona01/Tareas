import 'package:sqflite/sqflite.dart';
import 'package:path/path.dart';

class DB {
  static Future<Database> _openDB() async {
    return openDatabase(
      join(await getDatabasesPath(), 'dbalumnos.db'),
      onCreate: (db, version) async {
        await db.execute(
          "CREATE TABLE tblalumnos (id INTEGER PRIMARY KEY, nomAlumno TEXT, curp TEXT, sexo TEXT, discapacidad INTEGER)",
        );
        await db.execute(
          "CREATE TABLE tblDomicilios (id INTEGER PRIMARY KEY, direccion TEXT, ciudad TEXT, codigoPostal TEXT, idAlumno INTEGER, FOREIGN KEY (idAlumno) REFERENCES tblAlumnos(id))",
        );

        await db.execute(
          "CREATE TABLE tblDatosEscolares (id INTEGER PRIMARY KEY, secundaria TEXT, promedio REAL, especialidad TEXT, certificado INTEGER, idAlumno INTEGER, FOREIGN KEY (idAlumno) REFERENCES tblAlumnos(id))",
        );

        await db.execute(
          "CREATE TABLE tblTutores (id INTEGER PRIMARY KEY, nomTutor TEXT, correoTutor TEXT, telTutor TEXT, parentesco TEXT, idAlumno INTEGER, FOREIGN KEY (idAlumno) REFERENCES tblAlumnos(id))",
        );
      },

      version: 2,
    );
  }

  //para alumnos
  static Future<dynamic> insertAlumno(Alumno alumno) async {
    Database database = await _openDB();
    return database.insert("tblAlumnos", alumno.toMap());
  }

  static Future<dynamic> deleteAlumno(Alumno alumno) async {
    Database database = await _openDB();
    return database.delete(
      "tblAlumnos",
      where: "id = ?",
      whereArgs: [alumno.id],
    );
  }

  static Future<dynamic> updateAlumno(Alumno alumno) async {
    Database database = await _openDB();
    return database.update(
      "tblAlumnos",
      alumno.toMap(),
      where: "id = ?",
      whereArgs: [alumno.id],
    );
  }

  static Future<List<Alumno>> alumnos() async {
    Database database = await _openDB();
    final List<Map<String, dynamic>> alumnosmap = await database.query(
      "tblAlumnos",
    );
    return List.generate(
      alumnosmap.length,
      (i) => Alumno(
        id: alumnosmap[i]['id'],
        nomAlumno: alumnosmap[i]['nomAlumno'],
        curp: alumnosmap[i]['curp'],
        sexo: alumnosmap[i]['sexo'] ?? "",
        discapacidad: alumnosmap[i]['discapacidad'] ?? "",
      ),
    );
  }

