<?php
include("Conexion.php");

if ($_SERVER["REQUEST_METHOD"] == "POST") {
    $nomAlumno = $_POST['nomAlumno'];
    $apellidosAlumno = $_POST['apellidosAlumno'];
    $semestre  = $_POST['semestre'];
    $id_especialidad  = $_POST['id_especialidad'];


    if (!empty($nomAlumno) && !empty($apellidosAlumno)) {
        $sql = "INSERT INTO tblAlumnos (nomAlumno, apellidosAlumno, semestre, id_especialidad) VALUES (?, ?, ?, ?)";
        $stmt = $conn->prepare($sql);
        $stmt->bind_param("ssss", $nomAlumno, $apellidosAlumno,$semestre, $id_especialidad);

        if ($stmt->execute()) {
            echo "Alumno agregado correctamente.";
         
        } else {
            echo "Error: " . $conn->error;
        }
        $stmt->close();
    } else {
        echo "Por favor completa todos los campos.";
    }
}
