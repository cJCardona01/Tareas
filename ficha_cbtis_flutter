import 'package:flutter/material.dart';
import 'datos_escolares.dart';

class Domicilio extends StatefulWidget {
  @override
  _DomicilioState createState() => _DomicilioState();
  final Map<String, dynamic> datos;
  Domicilio({required this.datos});
}

class _DomicilioState extends State<Domicilio> {
  final _formKey = GlobalKey<FormState>();

  //nombre parentesco
  final TextEditingController direccionCtrl = TextEditingController();
  final TextEditingController ciudadCtrl = TextEditingController();
  final TextEditingController estadoCtrl = TextEditingController();
  final TextEditingController confirmacionCtrl = TextEditingController();

  String? estado;
  Map<String, bool> servicios = {
    "LapTop": false,
    "Smartphone": false,
    "Internet": false,
    "Ninguna": true,
  };
  void _validarFormulario() {
    
    List<String> seleccionadas = servicios.entries
        .where((e) => e.value)
        .map((e) => e.key)
        .toList();
  // Aquí se agregan los nuevos campos al map y se manda a la siguiente pantalla
    widget.datos["direccion"] = direccionCtrl.text;
    widget.datos["ciudad"] = ciudadCtrl.text;
    widget.datos["estado"] = estado;
    widget.datos["servicios"]=seleccionadas;
    if (_formKey.currentState!.validate()) {
      Navigator.push(
        context,
        MaterialPageRoute(builder: (context) => DatosEscolares(datos: widget.datos)),
      );
    }
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(title: Text("Registro de Domicilio")),
      body: SingleChildScrollView(
        padding: EdgeInsets.all(16),
        child: Form(
          key: _formKey,
          child: Column(
            children: [
              TextFormField(
                controller: direccionCtrl,
                decoration: InputDecoration(labelText: "Dirección"),
                validator: (value) {
                  if (value == null || value.isEmpty) {
                    return "Campo obligatorio";
                  }
                  return null;
                },
              ),
              TextFormField(
                controller: ciudadCtrl,
                decoration: InputDecoration(labelText: "Ciudad"),
                validator: (value) {
                  if (value == null || value.isEmpty) {
                    return "Campo obligatorio";
                  }
                  return null;
                },
              ),

              DropdownButtonFormField<String>(
                value: estado,
                hint: Text('Seleccione su Estado'),
                items:
                    [
                      'Michoacán',
                      'Jalisco',
                      'Yucatan',
                      'Durango',
                      'Nayarit',
                      'Guerrero',
                      'Sinaloa',
                      'Sonora',
                      'Nuevo Leon',
                    ].map((String value) {
                      return DropdownMenuItem<String>(
                        value: value,
                        child: Text(value),
                      );
                    }).toList(),
                onChanged: (val) => setState(() => estado = val),

                validator: (value) =>
                    value == null ? 'Selección obligatoria' : null,
              ),

              Column(
                children: servicios.keys.map((key) {
                  return CheckboxListTile(
                    title: Text(key),
                    value: servicios[key],
                    onChanged: (value) {
                      setState(() {
                        if (key == "Ninguna") {
                          servicios.updateAll((k, v) => false);
                        }
                        servicios[key] = value!;
                      });
                    },
                  );
                }).toList(),
              ),

              ElevatedButton(
                onPressed: () {
                  _validarFormulario();
                  if (_formKey.currentState!.validate()) {
                    print("Formulario correcto");
                    ScaffoldMessenger.of(
                      context,
                    ).showSnackBar(SnackBar(content: Text("Registro exitoso")));
                  }
                },

                child: Text("Registrar"),
              ),
            ],
          ),
        ),
      ),
    );
  } // aqui acaba build
}



